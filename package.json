{
  "name": "film-reading-lesson",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "고등학교 영화 교과 읽기자료·독서전략·수업지도안 생성 시스템",
  "scripts": {
    "predev": "npm run compile:data",
    "dev": "vite",
    "build": "npm run compile:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "compile:data": "tsx scripts/ttl-to-json.ts",
    "report:ttl": "tsx scripts/ttl-report.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:rules": "npx -y firebase-tools@13.24.1 emulators:exec --only firestore --project film-reading-lesson-test \"vitest run -c vitest.rules.config.ts\"",
    "build:demo": "npm run compile:data && tsc --noEmit && vite build --mode demo && node scripts/make-demo-page.mjs"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "fflate": "^0.8.2",
    "firebase": "^11.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.0",
    "@types/n3": "^1.21.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "n3": "^1.17.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
