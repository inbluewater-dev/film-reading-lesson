@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <http://example.org/reading#> .

# Ontology Declaration
ex:ReadingStrategyOntology a owl:Ontology ;
    rdfs:label "독서기능, 독서전략, 독서과정 온톨로지"@ko ;
    rdfs:comment "KNU 독서기능, 과정-기능 동사 및 해당 전략 매핑 데이터"@ko .

# Classes
ex:ReadingFunction a owl:Class ;
    rdfs:label "핵심기능"@ko .

ex:ReadingVerb a owl:Class ;
    rdfs:label "과정-기능에 해당하는 동사"@ko .

ex:ReadingStrategy a owl:Class ;
    rdfs:label "해당 전략(대표 예시)"@ko .

# Properties
ex:hasVerb a owl:ObjectProperty ;
    rdfs:domain ex:ReadingFunction ;
    rdfs:range ex:ReadingVerb ;
    rdfs:label "해당 동사를 가짐"@ko .

ex:hasStrategy a owl:ObjectProperty ;
    rdfs:domain ex:ReadingFunction ;
    rdfs:range ex:ReadingStrategy ;
    rdfs:label "해당 전략을 가짐"@ko .

# Instances & Relationships

# 1. 이해
ex:Func_Understanding a ex:ReadingFunction ;
    rdfs:label "이해"@ko ;
    ex:hasVerb ex:Verb_이해하다, ex:Verb_파악하다, ex:Verb_설명하다, ex:Verb_의미를_연결하다, ex:Verb_해석하다 ;
    ex:hasStrategy ex:Strat_단어의_나무, ex:Strat_낱말_접사_만들기, ex:Strat_손_그리기_활동, ex:Strat_감정표, ex:Strat_개념_정의_지도그리기, ex:Strat_LEAD_어휘연습, ex:Strat_밑줄_긋기, ex:Strat_빈칸_메우기, ex:Strat_중심생각_수레바퀴, ex:Strat_수학책을_읽는_열쇠 .

# 2. 탐색
ex:Func_Exploration a ex:ReadingFunction ;
    rdfs:label "탐색"@ko ;
    ex:hasVerb ex:Verb_살펴보다, ex:Verb_훑어보다, ex:Verb_질문하다, ex:Verb_조사하다, ex:Verb_예상하다, ex:Verb_찾아보다 ;
    ex:hasStrategy ex:Strat_SQ3R, ex:Strat_과학책_훑어보기, ex:Strat_미리보기, ex:Strat_앙케이트_질문표, ex:Strat_밑줄_긋기, ex:Strat_질문의_답은_어디에_QAR, ex:Strat_KWL .

# 3. 추론
ex:Func_Inference a ex:ReadingFunction ;
    rdfs:label "추론"@ko ;
    ex:hasVerb ex:Verb_추리하다, ex:Verb_유추하다, ex:Verb_근거를_찾다, ex:Verb_맥락을_파악하다, ex:Verb_숨은_의미를_발견하다 ;
    ex:hasStrategy ex:Strat_질문의_답은_어디에_QAR, ex:Strat_정교한_질문, ex:Strat_실마리_낱말로_유추하기, ex:Strat_빈칸_메우기, ex:Strat_경계_어휘전략, ex:Strat_예측_안내하기, ex:Strat_A_QU_A .

# 4. 예측
ex:Func_Prediction a ex:ReadingFunction ;
    rdfs:label "예측"@ko ;
    ex:hasVerb ex:Verb_예상하다, ex:Verb_가정하다, ex:Verb_전망하다, ex:Verb_추측하다, ex:Verb_미리_생각하다 ;
    ex:hasStrategy ex:Strat_어휘_예상하기, ex:Strat_예측_안내하기, ex:Strat_사진_속으로, ex:Strat_상상_속으로, ex:Strat_KWL, ex:Strat_실마리_낱말로_유추하기, ex:Strat_미리보기 .

# 5. 비교
ex:Func_Comparison a ex:ReadingFunction ;
    rdfs:label "비교"@ko ;
    ex:hasVerb ex:Verb_비교하다, ex:Verb_공통점을_찾다, ex:Verb_유사성을_분석하다, ex:Verb_연결하다 ;
    ex:hasStrategy ex:Strat_벤다이어그램, ex:Strat_의미자질_분석하기, ex:Strat_대조표, ex:Strat_대립_척도표 .

# 6. 대조
ex:Func_Contrast a ex:ReadingFunction ;
    rdfs:label "대조"@ko ;
    ex:hasVerb ex:Verb_대비하다, ex:Verb_차이점을_찾다, ex:Verb_구별하다, ex:Verb_구분하다 ;
    ex:hasStrategy ex:Strat_대조표, ex:Strat_벤다이어그램, ex:Strat_의미자질_분석하기, ex:Strat_대립_척도표 .

# 7. 분류
ex:Func_Classification a ex:ReadingFunction ;
    rdfs:label "분류"@ko ;
    ex:hasVerb ex:Verb_나누다, ex:Verb_범주화하다, ex:Verb_묶다, ex:Verb_유형화하다, ex:Verb_체계화하다 ;
    ex:hasStrategy ex:Strat_단어_분류하기, ex:Strat_의미자질_분석하기, ex:Strat_피라미드_다이어그램, ex:Strat_닿소리표_그리기, ex:Strat_낱말_접사_만들기 .

# 8. 관계화
ex:Func_Relation a ex:ReadingFunction ;
    rdfs:label "관계화"@ko ;
    ex:hasVerb ex:Verb_연결하다, ex:Verb_관련짓다, ex:Verb_구조화하다, ex:Verb_흐름을_파악하다, ex:Verb_맥락화하다 ;
    ex:hasStrategy ex:Strat_역사의_흐름_파악하기, ex:Strat_플롯_조직표, ex:Strat_이야기_지도_그리기, ex:Strat_의미_구조도_그리기, ex:Strat_인물망, ex:Strat_생각_그물, ex:Strat_상호텍스트_전략 .

# 9. 분석
ex:Func_Analysis a ex:ReadingFunction ;
    rdfs:label "분석"@ko ;
    ex:hasVerb ex:Verb_분석하다, ex:Verb_분해하다, ex:Verb_구조를_파악하다, ex:Verb_원인을_찾다, ex:Verb_검토하다 ;
    ex:hasStrategy ex:Strat_글_구조_전략, ex:Strat_오류_찾기, ex:Strat_단어_유래_찾기, ex:Strat_인물지도, ex:Strat_상호텍스트_전략, ex:Strat_수학책을_읽는_열쇠 .

# 10. 종합
ex:Func_Synthesis a ex:ReadingFunction ;
    rdfs:label "종합"@ko ;
    ex:hasVerb ex:Verb_종합하다, ex:Verb_통합하다, ex:Verb_요약하다, ex:Verb_재구성하다, ex:Verb_핵심화하다 ;
    ex:hasStrategy ex:Strat_요약하기, ex:Strat_자석_요약하기, ex:Strat_의미지도_그리기, ex:Strat_중심생각_수레바퀴, ex:Strat_생각_그물, ex:Strat_문학지도, ex:Strat_피라미드_다이어그램 .

# 11. 평가
ex:Func_Evaluation a ex:ReadingFunction ;
    rdfs:label "평가"@ko ;
    ex:hasVerb ex:Verb_판단하다, ex:Verb_비판하다, ex:Verb_검증하다, ex:Verb_근거를_따지다, ex:Verb_가치화하다 ;
    ex:hasStrategy ex:Strat_오류_찾기, ex:Strat_참_거짓_가리기, ex:Strat_대립_척도표, ex:Strat_상호텍스트_전략, ex:Strat_복식_기재_일지 .

# 12. 적용
ex:Func_Application a ex:ReadingFunction ;
    rdfs:label "적용"@ko ;
    ex:hasVerb ex:Verb_활용하다, ex:Verb_적용하다, ex:Verb_실행하다, ex:Verb_실천하다, ex:Verb_전이하다 ;
    ex:hasStrategy ex:Strat_RAFT, ex:Strat_수학책을_읽는_열쇠, ex:Strat_LEAD_어휘연습, ex:Strat_인물_따라하기 .

# 13. 창안
ex:Func_Creation a ex:ReadingFunction ;
    rdfs:label "창안"@ko ;
    ex:hasVerb ex:Verb_창조하다, ex:Verb_상상하다, ex:Verb_구안하다, ex:Verb_발명하다, ex:Verb_생성하다 ;
    ex:hasStrategy ex:Strat_브레인스토밍, ex:Strat_가능한_문장_만들기, ex:Strat_상상_속으로, ex:Strat_RAFT, ex:Strat_사진_속으로 .

# 14. 표현
ex:Func_Expression a ex:ReadingFunction ;
    rdfs:label "표현"@ko ;
    ex:hasVerb ex:Verb_표현하다, ex:Verb_말하다, ex:Verb_서술하다, ex:Verb_재현하다, ex:Verb_발표하다 ;
    ex:hasStrategy ex:Strat_다시_이야기하기, ex:Strat_인물_인용하기, ex:Strat_인물_따라하기, ex:Strat_RAFT, ex:Strat_문학지도, ex:Strat_손_그리기_활동 .

# 15. 조절(메타인지)
ex:Func_Regulation a ex:ReadingFunction ;
    rdfs:label "조절(메타인지)"@ko ;
    ex:hasVerb ex:Verb_점검하다, ex:Verb_반성하다, ex:Verb_계획하다, ex:Verb_조정하다, ex:Verb_성찰하다 ;
    ex:hasStrategy ex:Strat_KWL, ex:Strat_SQ3R, ex:Strat_복식_기재_일지, ex:Strat_A_QU_A, ex:Strat_정교한_질문 .


